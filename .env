# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/auth_db?schema=public"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379

# JWT Secrets & Configurations
JWT_ACCESS_SECRET="dev_access_secret_key_long_and_secure_minimum_10_chars"
JWT_REFRESH_SECRET="dev_refresh_secret_key_long_and_secure_minimum_10_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Security & Limits
ALLOW_UNVERIFIED_LOGIN=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# Email Infrastructure (SMTP - Nodemailer)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@authjwtms.com"

# Google OAuth Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Firebase Credentials
FIREBASE_SERVICE_ACCOUNT_JSON=""
