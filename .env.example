# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/auth_db?schema=public"

# Redis Configuration (For Rate Limiting & Health Readiness)
# REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379

# JWT Secrets & Configurations (Must be at least 10 chars)
JWT_ACCESS_SECRET="your_jwt_access_secret_key_at_least_10_chars"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_at_least_10_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Security & Limits
ALLOW_UNVERIFIED_LOGIN=false
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in milliseconds
RATE_LIMIT_MAX=10

# Email Infrastructure (SMTP - Nodemailer)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
SMTP_FROM="no-reply@authjwtms.com"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Firebase Credentials (For OAuth via Firebase ID Token Validation)
# Can be a JSON string representing the service account key, or a file path to service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"..."}'
